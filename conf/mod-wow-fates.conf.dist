#
# mod-wow-fates — configuration
#
# Expeditions appear at points of the map for a while; whoever takes part in
# one is rewarded by his level, and whoever is too strong for it is Synced:
# brought down to its level.
#
# Every value below is also the built-in default, so a setting left out changes
# nothing. Reloaded by `.reload config`.
#
# Copy this file to your configs/modules directory and drop the .dist extension.
#

[worldserver]

###############################################################################
#
#    WowFates.Enable
#        0 = no Expedition appears, the active ones end without rewards.
#

WowFates.Enable                         = 1

###############################################################################
#
#    SYNCED
#
#    A player in the area of an Expedition whose level is above it, or whose
#    power score is above the reference of its level, gets the Synced debuff
#    (spell 96000, its charges show the level). Each quantity is brought to
#    what a character of that level has:
#
#      stats, ratings, armor    cut by the ratio reference / score
#      maximum health and mana  to those of a character of his race and class
#                               at that level with the reference's gear: base
#                               health and mana of the level, plus what its
#                               stamina and intellect give (a level 80 in a
#                               level 7 Expedition: about 190 health)
#      damage and healing done  cut to the lower of the ratio and the level's
#                               share: the creatures' base damage at that
#                               level over his own, to DamageLevelExponent
#
#    WowFates.Synced.Enable
#        0 = nobody is synced; the Expeditions still run.
#
#    WowFates.Synced.Interval
#        Seconds between two measures of a synced player, so that a buff he
#        gets in the area is caught. Entering the area measures at once.
#
#    WowFates.Synced.MinRatio
#        The least share of his stats a player keeps, however strong.
#
#    WowFates.Synced.Reduce.Stats, .Ratings, .Health, .Mana, .Armor, .Damage, .Healing
#        How much of the gap each quantity loses, from 0 (nothing) to 1 (all
#        of it, down to the target).
#
#    WowFates.Synced.DamageLevelExponent
#        The power of the level's damage share. 1.0: a level 80 deals about
#        1.7 % of his damage in a level 7 Expedition (the most cut is 99 %).
#        Lower it if synced players hit too softly, raise it if too hard.
#
#    WowFates.Synced.PoolBonus
#        The target health and mana, times this. 1.15: a level 80 in a level 7
#        Expedition keeps about 245 health, 15 % above a level 7 of his class.
#

WowFates.Synced.Enable                  = 1
WowFates.Synced.Interval                = 5
WowFates.Synced.MinRatio                = 0.05
WowFates.Synced.Reduce.Stats            = 1.0
WowFates.Synced.Reduce.Ratings          = 1.0
WowFates.Synced.Reduce.Health           = 1.0
WowFates.Synced.Reduce.Mana             = 1.0
WowFates.Synced.Reduce.Armor            = 1.0
WowFates.Synced.Reduce.Damage           = 1.0
WowFates.Synced.Reduce.Healing          = 1.0
WowFates.Synced.DamageLevelExponent     = 1.0
WowFates.Synced.PoolBonus               = 1.15

###############################################################################
#
#    POWER SCORE
#
#    Read live on the player, the debuff left out:
#
#      PrimaryWeight   x (strength + agility + stamina + intellect + spirit)
#    + SecondaryWeight x ratings (hit, critical strike and haste counted once
#                        for melee, ranged and spells; expertise, armor
#                        penetration, defense, dodge, parry, block, resilience)
#    + PowerWeight     x the best of: attack power from gear and auras (not
#                        the part stats give), spell power, healing power
#
#    `.fates score` shows each part.
#

WowFates.Score.PrimaryWeight            = 1.0
WowFates.Score.SecondaryWeight          = 0.5
WowFates.Score.PowerWeight              = 0.5

###############################################################################
#
#    REFERENCE SCORE
#
#    What a character with the gear of a level scores, as "level:score"
#    points with a straight line between them (and past the ends). The
#    default is the median score of the random bots at their own level,
#    measured on the test realm with `.fates score`.
#
#    WowFates.Reference.Factor
#        Multiplies the whole curve. Raise it if Synced bites too hard,
#        lower it if strong players still breeze through.
#

WowFates.Reference.Curve                = "1:100 5:126 10:160 15:210 20:300 25:350 30:390 35:430 40:520 45:620 50:800 55:850 60:900 65:1300 70:2000 75:2350 80:3400"
WowFates.Reference.Factor               = 1.0

###############################################################################
#
#    EXPEDITIONS
#
#    Defined in the world database: mod_wow_fates_expedition, their spawn
#    points (mod_wow_fates_spawn), their rewards (mod_wow_fates_reward).
#    `.fates reload` reads them again.
#
#    Expeditions appear only in the zones (Elwynn Forest, Durotar...) where
#    there are players, picked at random by their weight among those of the
#    zone out of cooldown. A zone with players always has one: when its last
#    one ends, another of the zone comes at once, out of cooldown or not.
#
#    WowFates.Rotation.MaxPerZone
#        Expeditions at once in a zone with players. 0 = none but those
#        started by `.fates start`.
#
#    WowFates.Rotation.CountBots
#        1 = bots (sessions with no game client, such as mod-playerbots')
#        make a zone "with players"; 0 = only real players do. Bots may take
#        part in Expeditions and be rewarded either way, and their activity
#        keeps an Expedition alive.
#
#    WowFates.Rotation.IdleExpire
#        Seconds an Expedition waits for players: with no activity for that
#        long (no kill, damage, healing, object, channel), it goes and another
#        of the zone takes its place if the zone has players. Activity starts
#        the wait again; it never goes while players are at it. An
#        Expedition's own `duration` replaces it. 60 at least.
#
#    WowFates.Expedition.SpawnInterval
#        Seconds between two more Expeditions in a zone with players, up to
#        MaxPerZone.
#
#    WowFates.Expedition.Cooldown
#        Seconds an Expedition waits, once ended, before it may appear again,
#        when its own `cooldown` is 0.
#
#    WowFates.Expedition.AreaInterval
#        Milliseconds between two looks at who is in each area (entering,
#        leaving, monsters to bring back). 200 at least.
#

WowFates.Rotation.MaxPerZone            = 3
WowFates.Rotation.CountBots             = 0
WowFates.Rotation.IdleExpire            = 900
WowFates.Expedition.SpawnInterval       = 60
WowFates.Expedition.Cooldown            = 600
WowFates.Expedition.AreaInterval        = 1000

#
#    WowFates.Waves.PerCharacter
#        The monsters of a wave (defence, invocation, wave support): wave_size
#        times this for each character in the area, players and bots alike,
#        then wave_growth more for each wave already sent. 1 = wave_size per
#        character.
#
#    WowFates.Waves.PaceFast
#    WowFates.Waves.PaceStep
#    WowFates.Waves.PaceMax
#        The pace of the kills: a wave all killed within PaceFast of
#        wave_interval (0.5 = half of it) raises the next waves by PaceStep
#        (0.25 = a quarter more), PaceMax times at most; a wave killed slower,
#        or not all killed when the next one comes, brings them PaceStep back
#        toward their own size. It multiplies the characters' part.
#
#    WowFates.Expedition.ParticipantScaling
#        The players see a percentage, not a count: each kill brings 100 % /
#        (objective_count x (1 + ParticipantScaling x (players in the area - 1))),
#        the players counted at that kill. 0.6: alone, objective_count kills;
#        two players, 1.6 times as many; four, 2.8 times.
#

WowFates.Waves.PerCharacter             = 1.0
WowFates.Waves.PaceFast                 = 0.5
WowFates.Waves.PaceStep                 = 0.25
WowFates.Waves.PaceMax                  = 2.0
WowFates.Expedition.ParticipantScaling  = 0.6

#
#    WowFates.Expedition.AdaptiveSpawn
#        1 = the monsters an Expedition brings come back faster, and more of
#        them, when its area is cleared fast; when the pace drops, back to the
#        Expedition's own delay (summon_respawn) and number (summon_count).
#        The monsters of the game in the area keep their own respawn.
#
#        Each wave fills the area back up, at random points of it.
#
#    WowFates.Expedition.AdaptiveWindow
#        Seconds of kills the pace is read on.
#
#    WowFates.Expedition.AdaptiveAggression
#        The population sought: summon_count + kills per second x
#        summon_respawn x this.
#
#    WowFates.Expedition.MinAlivePct
#        Under this share of summon_count alive, the missing ones come at once,
#        without waiting for the next wave. 0 = never.
#
#    WowFates.Expedition.MinRespawn
#        Seconds, the shortest delay between two waves.
#
#    WowFates.Expedition.MaxPopulation
#        Times summon_count, the most monsters alive at once.
#

WowFates.Expedition.AdaptiveSpawn       = 1
WowFates.Expedition.AdaptiveWindow      = 15
WowFates.Expedition.AdaptiveAggression  = 1.5
WowFates.Expedition.MinAlivePct         = 50
WowFates.Expedition.MinRespawn          = 2
WowFates.Expedition.MaxPopulation       = 3.0

###############################################################################
#
#    PARTICIPATION
#
#    Standing in the area earns nothing. Each player's part is his damage
#    done in the area plus his healing of players fighting there, against
#    the average of those who did any (alone, a player is the average):
#
#      none     nothing done                          no reward
#      light    a kill, or any damage or healing      WowFates.Reward.LightPct
#      medium   MediumShare of the average or more    WowFates.Reward.MediumPct
#      strong   StrongShare of the average or more    every reward
#
#    Kills are measured the same way against the average of those who
#    killed; the better of the two counts.
#
#    He must also be within RewardRange times the radius when it ends.
#
#    WowFates.Participation.MediumShare
#    WowFates.Participation.StrongShare
#        0.5 = half the average contribution, 1.0 = the average.
#
#    WowFates.Participation.RewardRange
#        Times the radius of the Expedition. 1 at least.
#

WowFates.Participation.MediumShare      = 0.5
WowFates.Participation.StrongShare      = 1.0
WowFates.Participation.RewardRange      = 2.0

###############################################################################
#
#    REWARDS
#
#    Every row of mod_wow_fates_reward that matches the level is given: those
#    of expedition 0 and the Expedition's own. By participation: light and
#    medium give that share of each amount (money, experience, number of
#    items), rounded up; strong gives everything. An item given alone
#    (item_count 1) goes to a strong participation only. A hidden row shows
#    as a red "?" on the map and in the tracker until it is given.
#
#    WowFates.Reward.LevelMargin
#        -1 = the rewards of the player's level.
#        N  = of his level, but at most the Expedition's level + N: a level 80
#             finishing a level 7 Expedition with 3 gets the rewards of level 10.
#

WowFates.Reward.LevelMargin             = -1

#
#    WowFates.Reward.LightPct
#    WowFates.Reward.MediumPct
#        The share of each reward for a light and a medium participation.
#

WowFates.Reward.LightPct                = 33
WowFates.Reward.MediumPct               = 66
