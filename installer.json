      ]
    },
    "world": {
      "rows": [
        {
          "table": "module_string",
          "where": "module = 'mod-wow-fates'"
        },
        {
          "table": "module_string_locale",
          "where": "module = 'mod-wow-fates'"
        },
        {
          "table": "command",
          "where": "name = 'fates' OR name LIKE 'fates %'"
