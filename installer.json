        {
          "table": "spell_dbc",
          "where": "ID IN ({ids:Spell.dbc})"
        },
        {
          "table": "spell_custom_attr",
          "where": "spell_id IN ({ids:Spell.dbc})"
        },
        {
          "table": "creature_template",
          "where": "entry BETWEEN 96000 AND 96999"
        },
        {
          "table": "creature_template_model",
          "where": "CreatureID BETWEEN 96000 AND 96999"
        },
        {
          "table": "creature_template_locale",
          "where": "entry BETWEEN 96000 AND 96999"
        },
        {
          "table": "smart_scripts",
          "where": "source_type = 0 AND entryorguid BETWEEN 96000 AND 96999"
        },
        {
          "table": "gameobject_template",
          "where": "entry BETWEEN 960000 AND 969999"
        },
        {
          "table": "gameobject_template_locale",
          "where": "entry BETWEEN 960000 AND 969999"
        },
        {
          "table": "updates",
          "where": "name IN ({sql_files:world})"
